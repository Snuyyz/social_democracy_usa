title: Election Results
new-page: true
tags: event
priority: -1
view-if: in_election = 1
set-bg: img/map_2.jpg

= Election results, [+ month : month +] [+ year +]

on-arrival: {!
// Ensure vote shares / election math are available. The game normally
// runs the generic normalizer on each monthly tick (see main.scene.dry).
// If those values are missing (scene invoked directly), fall back to a
// minimal recompute of vote shares so the display below has sensible data.
if (typeof Q.dem_normalized === 'undefined') {
    // lightweight normalizer for the five-party setup
    var total_support = 0;
    for (var party of Q.parties) {
        var party_support = 0;
        for (var c of Q.classes) {
            // use class-specific breakdown if present, otherwise fall back
            var key = c + '_' + party;
            if (Q[key] === undefined) Q[key] = 0;
            // if per-class normalized share exists use it, otherwise the raw value
            var class_share = Q[key + '_normalized'] !== undefined ? Q[key + '_normalized'] : Q[key];
            party_support += Q[c] * (class_share || 0);
        }
        Q[party + '_support'] = party_support;
        total_support += party_support;
    }
    for (var party of Q.parties) {
        Q[party + '_normalized'] = total_support > 0 ? Q[party + '_support'] / total_support : (1 / Q.parties.length);
        Q[party + '_votes_dec'] = Math.round(Q[party + '_normalized'] * 1000) / 10;
        Q[party + '_votes'] = Math.round(Q[party + '_normalized'] * 100);
    }
}
!}

= Projected national results (if the election were held now)

Democrats: **[+ dem_votes +]%**
