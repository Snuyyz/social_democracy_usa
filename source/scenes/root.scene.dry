Q.student_debt_relief = 0;

// tax rates relative to 2015 baseline
Q.lower_tax_rates = 0;
Q.upper_tax_rates = 0;
Q.corporate_tax_rates = 0;

// our conduct vs. the establishment wing's conduct
// did the insurgent wing vote against a Dem leadership priority?
Q.insurgent_defection = 0;
// was a Squad-aligned member primaried out by the establishment wing?
Q.establishment_primaried_insurgent = 0;

// ==========================================================
// ADVISORS/ALLIES
// Per design policy: fictionalized composite figures, NOT real living
// politicians with invented dialogue/actions. Placeholder names below use
// a [FICTIONAL] convention during drafting; final names to be chosen
// separately so they read as clearly invented people.
// ==========================================================
Q.n_advisors = 3;
Q.timers = ['advisor_action', 'campaigning', 'ideology', 'fundraising',
            'media', 'inter_faction_relations', 'international_relations',
            'mobilization_alliance', 'enemies', 'party_organizations',
            'rally', 'canvassing', 'shuffle_leadership', 'strike_wave',
