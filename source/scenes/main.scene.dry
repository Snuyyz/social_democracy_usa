}

// ==========================================================
// Keep the Polls and Primary tabs on the status sidebar fresh.
// IDENTICAL to the block in @main above - see that copy for the full
// explanation. Keep both copies byte-for-byte identical when editing.
// ==========================================================
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
