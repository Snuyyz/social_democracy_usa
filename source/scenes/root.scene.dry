@start
on-arrival: {!
Q.started = 1;
// time elapsed (in months)
Q.time = 1;
Q.year = 2015;
Q.month = 1;
// how many actions have been taken this month?
Q.month_actions = 0;

// 0 = normal difficulty, 1 = hard mode, 2 = hard mode no saves
Q.difficulty = 0;
Q.historical_mode = 0;
Q.use_decimals = 0;

// organizational resources (was: party resources)
Q.resources = 2;
// dues/small-dollar donor base (was: dues)
Q.dues = 2;

// the state of the coalition-within-a-party.
// overall dissent reduces every increase in coalition support.
Q.dissent = 0.05;
Q.dissent_percent = 5;

// ==========================================================
// FACTIONS (was: SPD's left/center/labor/reformist/neorevisionist)
// These are the internal factions of the broad Democratic coalition
// that the player is trying to lead/steer from the insurgent-left flank.
// ==========================================================
Q.factions = ['insurgent', 'progressive', 'labor_left', 'establishment_dem', 'blue_dog'];

// insurgent: DSA/Squad-style democratic socialists. Player's home faction.
Q.insurgent_strength = 8;
Q.insurgent_dissent = 15;
// progressive: Warren-lane structural reformers.
Q.progressive_strength = 20;
Q.progressive_dissent = 5;
// labor_left: union-rooted, materially focused, culturally mixed.
Q.labor_left_strength = 22;
Q.labor_left_dissent = 5;
// establishment_dem: Obama/Biden-lane coalition managers. Cannot secede (see below).
Q.establishment_dem_strength = 40;
Q.establishment_dem_dissent = 0;
// blue_dog: right flank of the caucus, frontline-district survivalists.
Q.blue_dog_strength = 10;
Q.blue_dog_dissent = 5;

// Which factions are capable of splitting off to run independently if dissent
// gets too high? Every faction except establishment_dem (the "party as it is"
// baseline) can secede - mirrors the SPD/SAPD split, generalized.
Q.splittable_factions = ['insurgent', 'progressive', 'labor_left', 'blue_dog'];
// has this faction split off yet? 0 = no, 1 = yes (tracked per-faction below)
Q.insurgent_split = 0;
Q.progressive_split = 0;
Q.labor_left_split = 0;
Q.blue_dog_split = 0;
// dissent threshold above which a split becomes a live risk each election cycle
Q.split_dissent_threshold = 60;
// name of the breakaway party/organization once formed (set on split)
Q.insurgent_split_name = "";
Q.progressive_split_name = "";
Q.labor_left_split_name = "";
Q.blue_dog_split_name = "";

// have we discovered/formally adopted democratic-socialist ideology as a named program?
Q.dem_soc_program = 0;

// crisis_urgency indicates how seriously the coalition is taking the economic crisis - 0 to 10.
Q.crisis_urgency = 0;
// authoritarian_urgency indicates how seriously the coalition takes the Trumpist threat - 0 to 10.
Q.authoritarian_urgency = 0;
// radicalization indicates how radical the insurgent flank's rhetoric is - 0 to 10.
Q.radicalization = 0;
// support for a Green New Deal-style climate/jobs program
Q.gnd_support = 0;
Q.gnd_adopted = 0;
// support for Medicare for All
Q.m4a_support = 0;
Q.m4a_adopted = 0;
// support within the coalition for abolishing the filibuster
Q.filibuster_reform_support = 0;
// support for court reform/expansion
Q.court_reform_support = 0;
Q.court_reform_adopted = 0;
// have we adopted any major economic plan at all? 1 - GND, 2 - M4A, 3 - broader public-ownership agenda
Q.economic_plan = 0;
// have we formed a durable inside/outside mass-mobilization alliance (was: iron_front)?
Q.mobilization_alliance_formed = 0;
// support for a "dirty break" - contesting Dem primaries everywhere, no quarter for incumbents
Q.dirty_break_support = 0;
// support for public ownership / social-ownership proposals
Q.public_ownership_support = 0;
Q.public_ownership_adopted = 0;

// ==========================================================
// PARTIES (was: spd/kpd/z/ddp/dvp/dnvp/nsdap/other)
// For electoral/demographic math we track five vote-getting blocs.
// For CONGRESSIONAL SEAT MATH we only track two: dem_seats vs gop_seats
// (see section below) - factions influence internal control, not seat counts.
// ==========================================================
Q.parties = ['dem', 'gop', 'green', 'libertarian', 'other'];

// inter-coalition relations (was: z_relation, ddp_relation, dvp_relation, etc.)
// establishment_dem_relation folds into establishment_dem_strength/dissent above,
// since that's an internal faction, not a separate party.
Q.gop_estab_relation = 35;
// improving relations with the establishment/traditional GOP wing is a lever
// for pulling the party away from Trumpist capture - see maga_share below.
Q.green_relation = 40;
Q.libertarian_relation = 30;

// The GOP is not a monolith even though its SEATS are merged for congressional
// math. maga_share is the fraction of the GOP coalition/caucus under Trumpist
// control vs. the traditional/establishment wing. This can be moved by player
// action (improving relations with the establishment wing, exposing scandals,
// electoral defeats of MAGA-aligned members, etc.)
Q.maga_share = 55; // % of GOP caucus/coalition, starts modest in 2015, will rise
Q.gop_estab_share = 45;
// how personally dominant is Trump within the GOP specifically (distinct from
// maga_share, which is the ideological wing's size - this is his personal grip)
Q.trump_dominance = 20;

Q.gop_leader = "the Republican leadership";
Q.maga_leader = "Trump";
Q.dem_leader = "the Democratic leadership";
Q.green_leader = "the Green Party";

// SCOTUS - the independent check that isn't up for direct election (was: Hindenburg)
// -10 = solid liberal majority, +10 = solid conservative majority
Q.scotus_composition = 2;
Q.scotus_legitimacy = 55;
// whether SCOTUS is actively willing to strike down/block player-won legislation
Q.scotus_hostile = 0;

// Does the insurgent/progressive coalition control the House? the Senate?
Q.dem_house = 0;
Q.dem_senate = 0;
Q.dem_trifecta = 0;
// which chamber/branch does the player currently hold influence in
Q.in_house_majority = 0;
Q.in_senate_majority = 0;
Q.in_white_house = 0;

// ==========================================================
// MOVEMENT INFRASTRUCTURE (was: paramilitaries)
// Not literal private armies - this models organizing capacity and its
// dark mirror on the right. Militancy = willingness to strike/disrupt
// (left) or to escalate beyond normal politics (right), not routine violence.
// ==========================================================
// canvass_network: DSA/labor canvassing, mutual aid, strike capacity
Q.canvass_strength = 15; // in thousands of active volunteers/members
Q.canvass_militancy = 0.2;
Q.canvass_banned = 0;
// online_right: online-to-street right mobilization infrastructure
Q.online_right_strength = 20;
Q.online_right_militancy = 0.3;
Q.online_right_banned = 0;
// organized labor's independent strike capacity (distinct from labor_left faction)
Q.union_density = 11; // percent of workforce, roughly matches real 2015 baseline
Q.strike_wave_active = 0;

// law enforcement / federal capacity loyalty checks (was: reichswehr/police loyalty)
Q.federal_agencies_loyalty = 0.7; // loyalty to democratic norms, not to any party
Q.national_guard_loyalty = 0.75;

// The state of the country - popular opinion
// polarization: how nationally sorted/polarized opinion is (was: nationalism axis)
Q.polarization = 55;
// socialism vs capitalism - overall public sympathy for economic-left ideas
Q.socialism = 30;
// pro-democracy vs. tolerant-of-authoritarianism - baseline is high but contestable
Q.pro_democracy = 70;

Q.emergency_rule = 0;

// institutional reform trackers
Q.filibuster_reform = 0;
Q.court_reform = 0;
Q.electoral_college_reform_support = 0;
Q.voting_rights_protection = 0;
Q.dc_statehood = 0;

// coups/constitutional-crisis progress and capital-strike-style donor revolt
// (was: coup_progress, capital_strike_progress) - these are an additional
// check on the player's policies beyond the ballot box.
Q.constitutional_crisis_progress = 0;
Q.donor_strike_progress = 0;

Q.budget = 4;

// ==========================================================
// DEMOGRAPHIC CLASSES (was: workers/old_middle/new_middle/rural/unemployed/catholics)
// Matches how US electoral analysis actually segments the electorate.
// ==========================================================
Q.classes = ['working_class', 'college_educated', 'non_college_white', 'black_voters', 'latino_voters', 'suburban', 'rural'];

Q.working_class = 32;
Q.college_educated = 33;
Q.non_college_white = 42; // overlaps other categories in reality; abstracted here
Q.black_voters = 12;
Q.latino_voters = 18;
Q.suburban = 45; // overlaps; abstracted
Q.rural = 20;
Q.unemployed = 5.0;

// income, in real 2015 dollars, median household - rough backdrop stat
Q.income = 56500;
// inflation (%, annual)
Q.inflation = 0.1;
// economic growth (%, annual real GDP growth)
Q.economic_growth = 2.9;
// economic expansion timer
Q.economic_expansion = 0;

// quality of life indices (% of 2015 baseline)
Q.working_class_qol = 100;
Q.rural_qol = 100;
Q.black_voters_qol = 100;
Q.latino_voters_qol = 100;

// ==========================================================
// PARTY SUPPORT BY DEMOGRAPHIC (was: workers_spd, workers_kpd, etc.)
// Don't need to sum to 100 - normalized at election time.
// ==========================================================
// Calibrated so the NATIONAL two-party margin lands close to even
// (roughly D+1 to D+2, consistent with the 2012 popular vote environment
// this game's 2015 starting point inherits) rather than an unrealistic
// blowout lean - the Electoral College math in general_algorithm depends
// on the national margin being in a genuinely competitive range for the
// swing blocs to behave like swing blocs.
Q.working_class_dem = 44;
Q.working_class_gop = 41;
Q.working_class_green = 3;
Q.working_class_libertarian = 2;
Q.working_class_other = 10;

Q.college_educated_dem = 52;
Q.college_educated_gop = 36;
Q.college_educated_green = 4;
Q.college_educated_libertarian = 3;
Q.college_educated_other = 5;

Q.non_college_white_dem = 29;
Q.non_college_white_gop = 60;
Q.non_college_white_green = 1;
Q.non_college_white_libertarian = 2;
Q.non_college_white_other = 8;

Q.black_voters_dem = 85;
Q.black_voters_gop = 8;
Q.black_voters_green = 1;
Q.black_voters_libertarian = 1;
Q.black_voters_other = 5;

Q.latino_voters_dem = 60;
Q.latino_voters_gop = 31;
Q.latino_voters_green = 2;
Q.latino_voters_libertarian = 2;
Q.latino_voters_other = 5;

Q.suburban_dem = 45;
Q.suburban_gop = 46;
Q.suburban_green = 2;
Q.suburban_libertarian = 3;
Q.suburban_other = 4;

Q.rural_dem = 28;
Q.rural_gop = 62;
Q.rural_green = 1;
Q.rural_libertarian = 2;
Q.rural_other = 7;

// how much of the "dem" bloc's support is currently attributable to
// insurgent-left enthusiasm vs. establishment/moderate enthusiasm - drives
// primary math distinctly from general-election math.
Q.dem_primary_insurgent_share = 15;
Q.dem_primary_progressive_share = 20;
Q.dem_primary_labor_left_share = 20;
Q.dem_primary_establishment_dem_share = 40;
Q.dem_primary_blue_dog_share = 5;

// ==========================================================
// CONGRESSIONAL SEAT MATH (was: Reichstag %)
// Per design decision: GOP and Dem seats are merged into two numbers each;
// internal faction strength (above) drives influence, not separate seat pools.
// House: 435 seats, Senate: 100 seats (33/34 up per cycle)
// Baseline: 2015 (114th Congress) - GOP holds both chambers.
// ==========================================================
Q.dem_house_seats = 188;
Q.gop_house_seats = 247;
Q.dem_senate_seats = 44;
Q.gop_senate_seats = 54;
// independents caucusing with Dems (e.g. Sanders/King) counted within dem_senate_seats already

Q.old_dem_house_seats = 188;
Q.old_gop_house_seats = 247;
Q.old_dem_senate_seats = 44;
Q.old_gop_senate_seats = 54;

// array of objects for each election / each month, for history tracking
Q.election_records = [];
Q.party_support_records = [];
Q.economic_records = [];

// ==========================================================
// STATE OF GOVERNMENT (was: president/chancellor/cabinet)
// ==========================================================
Q.president = "Obama";
Q.president_party = "dem";
// is the player's coalition currently holding the White House?
Q.dem_president = 1;

// cabinet-style tracking, simplified relative to Weimar's multi-party cabinet
Q.treasury_secretary = "Lew";
Q.state_secretary = "Kerry";
Q.labor_secretary = "Perez";
Q.attorney_general = "Lynch";

// does the insurgent/progressive wing have any cabinet-level influence yet?
Q.insurgent_cabinet_influence = 0;

// Events: what has occurred?
Q.bernie_announced = 0;
Q.dsa_refounded = 0;
Q.squad_elected = 0;
Q.primary_challenge_wave = 0;
Q.jan6_style_event = 0;
Q.court_packing_fight_seen = 0;

// have we won these structural reforms?
Q.voting_rights_reform = 0;
Q.labor_law_reform = 0;
Q.healthcare_expansion = 0; // 0 = ACA baseline, higher = public option/M4A steps
Q.welfare = 0; // level of welfare relative to 2015 baseline, can go negative
Q.climate_policy = 0;
Q.immigration_reform = 0;

// works-program equivalent (was: WTB plan) - a jobs guarantee / GND-style
// direct-hire program, if adopted
Q.jobs_program = 0;
Q.jobs_program_implemented = 0;

// foreign policy trackers (much lighter than the original - US is a global
// hegemon here, not a defeated power negotiating reparations/rearmament)
Q.foreign_policy_restraint = 0; // support within the coalition for restraint/anti-interventionism
Q.nato_relation = 0;
Q.china_relation = 0;
Q.latin_america_relation = 0;
Q.immigration_enforcement = 0; // relative to 2015 baseline, can go negative (less enforcement)

// science/education
