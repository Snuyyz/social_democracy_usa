title: Election
on-arrival: {!
// ==========================================================
// GENERIC VOTE-SHARE NORMALIZER
// Reused by the primary, general, and midterm algorithms below.
// Unlike Weimar's single proportional Reichstag system, the US has three
// distinct election types with three different ways of turning vote share
// into power (delegates, an Electoral College, and a seat-swing model).
// This block only computes normalized demographic x party support - the
// seat/delegate/EC math happens in the type-specific sub-algorithms below.
// ==========================================================

// calculate normalized class voting amounts (0 to 100)
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}

// 1. calculate support for each of the parties
var total_support = 0;
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) {
            // allows for "spillover" effects in other demographics -
            // campaigning among one class can bleed into overall support.
            party_support += Q[c]*Q[c+'_'+party];
        } else  {
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        }
    }
    Q[party + '_support'] = party_support;
    total_support += party_support;
}
// 2. normalize support (fraction)
// 3. Round to integers (or one decimal, if use_decimals)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    Q[party+'_votes_dec'] = Math.round(Q[party+'_normalized']*1000)/10;
    if (Q.use_decimals) {
        Q[party+'_votes'] = Q[party+'_votes_dec'];
        Q[party + '_votes_disp'] = Q[party+'_votes'];
    } else {
        Q[party+'_votes'] = Math.round(Q[party+'_normalized']*100);
        Q[party + '_votes_disp'] = Q[party+'_votes_dec'].toFixed(1);
    }
}
!}
go-to: jumpScene

# note: this is a helpful utility to deal with elections and so on.
# It only computes vote share. See primary_algorithm, general_algorithm, and
# midterm_algorithm below for how each election type converts vote share into
# actual power (delegates / Electoral College / seats).


@primary_algorithm
title: Democratic Primary
on-arrival: {!
// ==========================================================
// PRIMARY ALGORITHM (no Weimar equivalent - new system)
// Runs the generic normalizer over Q.factions instead of Q.parties, using
// the dem_primary_*_share variables as the "support by class" input, so
// the SAME demographic-by-class engine can be reused for an intra-party
// contest. Produces delegate shares for each of the five factions.
// A faction that has already split off (see root.scene.dry) does not
// compete in the primary - it runs its own separate line in the general.
// ==========================================================

// build a temporary "parties" list out of factions that haven't split
var active_factions = [];
for (var f of Q.factions) {
    if (Q.splittable_factions.indexOf(f) === -1 || Q[f + '_split'] !== 1) {
        active_factions.push(f);
    }
}
Q.active_primary_factions = active_factions;

// normalize class voting amounts among active factions only
for (var c of Q.classes) {
    var class_votes = 0;
    for (var f of active_factions) {
        var key = 'dem_primary_' + c + '_' + f;
        if (Q[key] === undefined) {
            // fall back to the overall (non-class-specific) share if no
            // class breakdown has been set for this faction yet.
            Q[key] = Q['dem_primary_' + f + '_share'] || 0;
        }
        if (Q[key] < 0) {
            Q[key] = 0;
        }
        class_votes += Q[key];
    }
    for (var f of active_factions) {
        var key = 'dem_primary_' + c + '_' + f;
        Q[key + '_normalized'] = class_votes > 0 ? 100*Q[key]/class_votes : (100/active_factions.length);
    }
}

// aggregate into overall delegate share
var total_support = 0;
for (var f of active_factions) {
    var support = 0;
    for (var c of Q.classes) {
        support += Q[c] * Q['dem_primary_' + c + '_' + f + '_normalized'];
    }
    Q['primary_support_' + f] = support;
    total_support += support;
}
for (var f of Q.factions) {
    if (active_factions.indexOf(f) !== -1) {
        Q['primary_delegate_share_' + f] = Math.round(1000*Q['primary_support_' + f]/total_support)/10;
    } else {
        // split-off factions get 0 delegates - they aren't contesting the primary
        Q['primary_delegate_share_' + f] = 0;
    }
}

// who wins the nomination? plurality among active factions, ties favor
// the player's own faction (insurgent) if it is tied for first, otherwise
// favor establishment_dem as the default institutional outcome.
var winner = 'establishment_dem';
var best = -1;
for (var f of active_factions) {
    if (Q['primary_delegate_share_' + f] > best) {
        best = Q['primary_delegate_share_' + f];
        winner = f;
    } else if (Q['primary_delegate_share_' + f] === best && f === 'insurgent') {
        winner = f;
    }
}
Q.primary_winner_faction = winner;
!}
go-to: jumpScene


@general_algorithm
title: General Election
on-arrival: {!
// ==========================================================
// GENERAL ELECTION ALGORITHM (was: direct proportional Reichstag math)
// The US presidency is decided by an Electoral College, not a national
// popular vote, so a straight nationwide-proportional conversion (as
// Weimar uses) would misrepresent how this actually works. We abstract
// the 538 electoral votes into 9 blocs sized to roughly match real
// elector counts, and swing each bloc off the NATIONAL two-party margin
// plus a bloc-specific lean. This is a deliberate simplification (no
// state-by-state modeling of all 50 states) in the same spirit as the
// original abstracting away all 35 Reichstag election districts.
// ==========================================================

// national two-party margin, positive = dem advantage, from the normalized
// vote shares computed by the generic algorithm above (call that first!)
var dem_share = Q.dem_normalized || 0.5;
var gop_share = Q.gop_normalized || 0.5;
var two_party_total = dem_share + gop_share;
var national_margin = two_party_total > 0 ? (dem_share - gop_share)/two_party_total : 0;
Q.national_dem_margin = Math.round(national_margin*1000)/10; // in points, e.g. 4.2

// bloc definitions: [electoral votes, lean in points (positive = leans dem)]
var blocs = {
    'safe_dem':          {ev: 191, lean: 25},
    'safe_gop':          {ev: 149, lean: -25},
    'rust_belt':         {ev: 46,  lean: 1},
    'sun_belt':          {ev: 49,  lean: -4},
    'southwest':         {ev: 30,  lean: 2},
    'midwest_swing':     {ev: 26,  lean: -1},
    'new_england_swing': {ev: 11,  lean: 3},
    'mountain_west':     {ev: 12,  lean: -2},
    'mid_atlantic_swing':{ev: 24,  lean: 2}
};

var dem_ev = 0;
var gop_ev = 0;
Q.ec_bloc_results = {};
for (var bloc in blocs) {
    var margin_here = national_margin*100 + blocs[bloc].lean;
    var dem_wins = margin_here > 0;
    if (dem_wins) {
        dem_ev += blocs[bloc].ev;
    } else {
        gop_ev += blocs[bloc].ev;
    }
    Q.ec_bloc_results[bloc] = {margin: Math.round(margin_here*10)/10, winner: dem_wins ? 'dem' : 'gop'};
}
Q.dem_electoral_votes = dem_ev;
Q.gop_electoral_votes = gop_ev;
Q.electoral_votes_needed = 270;
Q.dem_president_elect = dem_ev >= 270 ? 1 : 0;

// which faction's candidate is on the ballot as the Democratic nominee
// carries through from the primary algorithm, if a primary happened this cycle
if (!Q.primary_winner_faction) {
    Q.primary_winner_faction = 'establishment_dem';
}
!}
go-to: jumpScene


@midterm_algorithm
title: Midterm Election
on-arrival: {!
// ==========================================================
// MIDTERM ALGORITHM (was: direct proportional Reichstag math)
// US midterms don't reallocate all 435 House seats proportionally to
// national vote share the way Weimar's Reichstag elections did - they
// swing a subset of seats off the generic-ballot margin, with a strong
// structural home-field disadvantage for the party holding the White
// House (a very robust real pattern this model should capture).
// Senate seats: only the seats up in a given class (1/3 of the chamber)
// are contestable each cycle - modeled here as a fixed swing pool.
// ==========================================================

var dem_share = Q.dem_normalized || 0.5;
var gop_share = Q.gop_normalized || 0.5;
var two_party_total = dem_share + gop_share;
var generic_ballot_margin = two_party_total > 0 ? (dem_share - gop_share)/two_party_total : 0;
Q.generic_ballot_margin = Math.round(generic_ballot_margin*1000)/10;

// midterm penalty: the party holding the White House tends to lose ground,
// roughly 2-4 points off the generic ballot, historically.
var incumbent_penalty = 3;
var effective_margin = generic_ballot_margin*100 - (Q.dem_president ? incumbent_penalty : -incumbent_penalty);

// House: ~40 seats are treated as "in play" each cycle (roughly matches
// real competitive-seat counts); the rest are safe and don't move.
var house_seats_in_play = 40;
var house_swing = Math.round(house_seats_in_play * (effective_margin/100));
// clamp so we can't swing more seats than exist in the in-play pool
if (house_swing > house_seats_in_play) house_swing = house_seats_in_play;
if (house_swing < -house_seats_in_play) house_swing = -house_seats_in_play;

Q.old_dem_house_seats = Q.dem_house_seats;
Q.old_gop_house_seats = Q.gop_house_seats;
Q.dem_house_seats = Q.dem_house_seats + house_swing;
Q.gop_house_seats = Q.gop_house_seats - house_swing;
// keep the total fixed at 435
if (Q.dem_house_seats + Q.gop_house_seats !== 435) {
    Q.gop_house_seats = 435 - Q.dem_house_seats;
}
Q.house_seat_swing = house_swing;

// Senate: only 1/3 of seats up each cycle. We model a fixed pool of 34
// contestable seats per midterm (alternating slightly in reality, fixed
// here for simplicity) with a smaller swing than the House.
var senate_seats_in_play = 34;
var senate_swing = Math.round((senate_seats_in_play/2) * (effective_margin/100));
if (senate_swing > Math.floor(senate_seats_in_play/2)) senate_swing = Math.floor(senate_seats_in_play/2);
if (senate_swing < -Math.floor(senate_seats_in_play/2)) senate_swing = -Math.floor(senate_seats_in_play/2);

Q.old_dem_senate_seats = Q.dem_senate_seats;
Q.old_gop_senate_seats = Q.gop_senate_seats;
Q.dem_senate_seats = Q.dem_senate_seats + senate_swing;
Q.gop_senate_seats = Q.gop_senate_seats - senate_swing;
if (Q.dem_senate_seats + Q.gop_senate_seats !== 100) {
    Q.gop_senate_seats = 100 - Q.dem_senate_seats;
}
Q.senate_seat_swing = senate_swing;

// chamber control flags
Q.dem_house = Q.dem_house_seats > Q.gop_house_seats ? 1 : 0;
Q.dem_senate = Q.dem_senate_seats > Q.gop_senate_seats ? 1 : 0;
Q.dem_trifecta = (Q.dem_house && Q.dem_senate && Q.dem_president) ? 1 : 0;
Q.in_house_majority = Q.dem_house;
Q.in_senate_majority = Q.dem_senate;
!}
go-to: jumpScene
